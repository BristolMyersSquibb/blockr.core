{
  "name": "@blockr/core",
  "private": true,
  "description": "The types that the modules of blockr.core's client are written against, a stub of each host for their tests, the React SDK, its binding and the build preset that they may be built with, and the controls they may draw with, as the R package blockr.core ships them.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./binding": {
      "types": "./binding/index.d.ts",
      "default": "./binding/index.js"
    },
    "./build": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./react": {
      "types": "./react/index.d.ts",
      "default": "./react/index.js"
    },
    "./stubs": {
      "types": "./stubs/index.d.ts",
      "default": "./stubs/index.js"
    },
    "./controls": {
      "types": "./controls/index.d.ts",
      "default": "./controls/index.js"
    }
  },
  "dependencies": {
    "@preact/signals-core": "1.14.5",
    "@cfworker/json-schema": "4.1.4",
    "react-aria-components": "1.22.1",
    "@internationalized/date": "3.12.4"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@opentelemetry/api": "1.10.0"
  }
}
