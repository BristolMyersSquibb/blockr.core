{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "renderer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "css": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "module"
      ]
    },
    "width": {
      "type": "number"
    },
    "height": {
      "type": "number"
    }
  },
  "required": [
    "height",
    "renderer",
    "width"
  ]
}
