{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "class": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/definitions/BlockId"
          },
          "registry_id": {
            "$ref": "#/definitions/RegistryId"
          },
          "state": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/Json"
            }
          },
          "name": {
            "type": "string"
          },
          "attrs": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/Json"
            }
          }
        },
        "required": [
          "attrs",
          "name",
          "registry_id",
          "state"
        ]
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/definitions/LinkId"
          },
          "from": {
            "$ref": "#/definitions/BlockId"
          },
          "to": {
            "$ref": "#/definitions/BlockId"
          },
          "input": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "input",
          "to"
        ]
      }
    },
    "stacks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/definitions/StackId"
          },
          "name": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/BlockId"
            }
          }
        },
        "required": [
          "blocks",
          "name"
        ]
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Json"
      }
    }
  },
  "required": [
    "class",
    "blocks",
    "links",
    "stacks",
    "options"
  ],
  "definitions": {
    "BlockId": {
      "type": "string"
    },
    "RegistryId": {
      "type": "string"
    },
    "Json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Json"
          }
        }
      ]
    },
    "LinkId": {
      "type": "string"
    },
    "StackId": {
      "type": "string"
    }
  }
}
