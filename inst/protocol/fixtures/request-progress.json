{
  "description": "A long request of an extension, as blockr.md's export of a report to PowerPoint would be, for which R sends progress notes, each in a message of its own, before it replies with the file as the reply's binary body, which body announces with its MIME type and name.",
  "client": [
    {
      "id": "28",
      "kind": "request",
      "extension": "blockr.md-md",
      "name": "export",
      "args": { "format": "pptx" },
      "reads": [{ "block": "c", "revision": 4 }]
    }
  ],
  "r": [
    [
      {
        "id": "28",
        "progress": { "value": 0.3, "message": "Rendering the report" }
      }
    ],
    [
      {
        "id": "28",
        "progress": { "value": 0.8, "message": "Converting to PowerPoint" }
      }
    ],
    [
      {
        "id": "28",
        "status": "ok",
        "body": {
          "type": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
          "name": "report.pptx"
        }
      }
    ]
  ]
}
