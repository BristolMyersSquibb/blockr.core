# Two settings guard what npm installs in this repository.
# The npm 10 of Node 22 ignores them.
# The commands below need npm 11.18.0 or later.
#
# With min-release-age=7, npm writes a version into package-lock.json only
# once it was published more than 7 days ago.
# A compromised release then cannot enter the lockfile during those days.
#
# With strict-allow-scripts=true, an install fails before any script runs when
# a dependency has an install script that allowScripts in package.json does
# not cover.
# Each entry there approves the scripts of one version.
# To add or upgrade a dependency with install scripts:
#
# 1. Install it without running any install script:
#    npm install --ignore-scripts <pkg>@<version>
#    Without the flag, the install fails before it installs anything.
# 2. List the scripts with npm install-scripts ls, and read each one.
# 3. Approve them, each at its installed version:
#    npm install-scripts approve --all
# 4. Run the approved scripts: npm rebuild
#
# The entry of fsevents is written by hand.
# The package installs only on macOS, where its install script runs
# node-gyp rebuild.
# On Linux, npm skips it, so npm install-scripts approve cannot see it, and
# npm install-scripts prune would remove its entry.
min-release-age=7
strict-allow-scripts=true
