{
  // The build, the tests and their helpers run in Node and see its types, but
  // are otherwise checked as the client is.
  "extends": "./tsconfig.client.json",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"],
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["srcts/build", "srcts/testing", "srcts/**/*.test.ts", "srcts/**/*.test.tsx", "*.config.ts"],
  "exclude": []
}
