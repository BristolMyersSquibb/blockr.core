request_call.code_request <- function(x, reads, ...) {
  script <- function(reads) {
    code <- vapply(reads, function(r) deparse1(r$expr), character(1L))
    paste(names(reads), "<-", code)
  }
  list(fun = script, args = list(reads = reads))
